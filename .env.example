# Lead and purchase notifications. Without these the routes return an error and the
# customer's journey carries on regardless, so a missing key never blocks a signup.

# Resend. Required for the email alert.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Where the alerts go. Defaults to jake@ripleads.com.
NOTIFY_TO_EMAIL=

# Slack, optional. Both must be set or Slack is skipped entirely.
# SLACK_CONNECTOR is a Vercel Connect connector, e.g. slack/sunnycells-orders.
# SLACK_CHANNEL is the channel id, not its name.
SLACK_CONNECTOR=
SLACK_CHANNEL=

# Meta pixel and Conversions API. Both must be SUNNYCELLS' own dataset, not
# another brand's: events sent to a different pixel corrupt attribution for both.
# The pixel id is public by design (it ships in the page). The CAPI token is not.
# Leave both unset and no pixel renders and no event is sent.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# The Even Energy funnel reports to its own dataset. Everything under
# /products/even-energy uses this pair, everything else uses the one above, and an
# event never reaches both. Unset means no pixel and no event on that funnel only.
NEXT_PUBLIC_META_PIXEL_ID_ENERGY=
META_CAPI_ACCESS_TOKEN_ENERGY=

# The aging funnel reports to its own dataset too. Everything under /quiz/aging uses
# this pair, and nothing else does. Unset means no pixel and no event on that funnel
# only, which is how a funnel without its own dataset stays out of another one's.
NEXT_PUBLIC_META_PIXEL_ID_AGING=
META_CAPI_ACCESS_TOKEN_AGING=

# Daily Reds has its own dataset slot too. Unset means the product page reports nowhere,
# which is deliberate: it keeps an unrouted path out of the weight loss dataset.
NEXT_PUBLIC_META_PIXEL_ID_REDS=
META_CAPI_ACCESS_TOKEN_REDS=
NEXT_PUBLIC_META_PIXEL_ID_REVITALIZE=
