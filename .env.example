# Lead and purchase notifications. Without these the routes return an error and the
# customer's journey carries on regardless, so a missing key never blocks a signup.

# Resend. Required for the email alert.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Where the alerts go. Defaults to jake@ripleads.com.
NOTIFY_TO_EMAIL=

# Slack, optional. Both must be set or Slack is skipped entirely.
# SLACK_CONNECTOR is a Vercel Connect connector, e.g. slack/sunnycells-orders.
# SLACK_CHANNEL is the channel id, not its name.
SLACK_CONNECTOR=
SLACK_CHANNEL=
